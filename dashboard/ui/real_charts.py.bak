import plotly.graph_objects as go

def catch_chart(df, show_hindsight=False):
    fig = go.Figure()
    x=df['week']
    fig.add_trace(go.Scatter(x=x,y=df['catch_high'],mode='lines',line=dict(width=0),showlegend=False,hoverinfo='skip'))
    fig.add_trace(go.Scatter(x=x,y=df['catch_low'],mode='lines',fill='tonexty',fillcolor='rgba(38,139,199,.22)',line=dict(width=0),name='90% uncertainty band',hoverinfo='skip'))
    fig.add_trace(go.Scatter(x=x,y=df['catch_rate'],name='ClinicDrift belief',mode='lines+markers',line=dict(color='#32a5d9',width=3)))
    fig.add_trace(go.Scatter(x=x,y=df['est_sensitivity'],name='Naive image-only estimate',mode='lines',line=dict(color='#edb657',dash='dash')))
    if show_hindsight and 'true_sensitivity' in df:
        fig.add_trace(go.Scatter(x=x,y=df['true_sensitivity'],name='Hindsight: full expert grades',mode='lines+markers',line=dict(color='#df7295',dash='dot')))
    fig.update_layout(height=370,margin=dict(l=5,r=5,t=20,b=10),yaxis=dict(title='Catch rate',range=[0,1],tickformat='.0%'),xaxis=dict(title='Simulated week',dtick=1),hovermode='x unified',legend=dict(orientation='h',y=-.3))
    return fig

def drift_chart(df):
    fig=go.Figure()
    fig.add_trace(go.Scatter(x=df.week,y=df.drift_auc,mode='lines+markers',name='Drift AUC',line=dict(color='#9e89e8',width=3)))
    fig.add_hline(y=.7,line_dash='dot',annotation_text='Trust begins falling (0.7)')
    fig.add_hline(y=.9,line_dash='dash',annotation_text='Untrusted (0.9)')
    fig.update_layout(height=280,margin=dict(l=5,r=5,t=15,b=5),yaxis=dict(range=[.45,1.02],title='Drift AUC'),xaxis=dict(title='Simulated week',dtick=1))
    return fig
