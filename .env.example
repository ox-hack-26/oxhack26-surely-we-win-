# Copy to .env and fill in. .env is never committed.

# Folder for scans, features and outputs. Keep it outside OneDrive/Dropbox (~10 GB).
CLINICDRIFT_DATA=C:/Users/you/clinicdrift-data

# Tiger Data (Tiger Cloud) service URL, for scripts/load_tiger.py:
# postgres://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
TIMESCALE_SERVICE_URL=

# Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# tried in order when GEMINI_MODEL is unavailable or out of quota (each has its own daily limit)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2
